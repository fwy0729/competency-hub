---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';

const books = [
  {
    title: '《核心素养导向的课程与教学》',
    author: '余文森',
    desc: '系统阐述核心素养如何落地到课程设计和课堂教学，理论与实践结合。',
  },
  {
    title: '《项目式学习：设计与实施指南》',
    author: '巴克教育研究所',
    desc: 'PBL的完整操作手册，从选题到评价，附大量案例和工具。',
  },
  {
    title: '《理解为先的模式》（UbD）',
    author: '威金斯 & 麦克泰格',
    desc: '逆向设计经典著作，先定目标和评价，再设计教学活动。',
  },
  {
    title: '《学会学习》',
    author: '联合国教科文组织',
    desc: '面向21世纪的学习框架，帮助理解什么是真正的"学会"。',
  },
];
---
<BaseLayout title="资源库">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary/5 via-white to-accent/5 py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="section-title">资源库</h1>
      <p class="section-subtitle mx-auto">
        持续更新中，帮你更快更好地落地核心素养
      </p>
    </div>
  </section>

  <!-- Rubric Placeholder -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="card bg-accent/5 border-dashed border-2 border-accent/30 text-center py-12">
        <span class="text-5xl block mb-4">📐</span>
        <h2 class="text-2xl font-bold mb-2">量规模板</h2>
        <p class="text-text-light">各学科核心素养评价量规正在准备中，即将上线</p>
        <p class="text-sm text-gray-400 mt-2">敬请期待</p>
      </div>
    </div>
  </section>

  <!-- Books -->
  <section class="py-16 bg-bg">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="section-title text-center">推荐阅读</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
        {books.map(b => (
          <div class="card">
            <span class="text-3xl mb-3 block">📖</span>
            <h3 class="text-lg font-bold text-text mb-1">{b.title}</h3>
            <p class="text-sm text-primary font-medium mb-3">{b.author}</p>
            <p class="text-sm text-text-light leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Toolkit Placeholder -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="card bg-primary/5 border-dashed border-2 border-primary/20 text-center py-12">
        <span class="text-5xl block mb-4">🛠️</span>
        <h2 class="text-2xl font-bold mb-2">工具包</h2>
        <p class="text-text-light">项目设计模板、评价工具、课堂管理工具等正在开发中</p>
        <p class="text-sm text-gray-400 mt-2">敬请期待</p>
      </div>
    </div>
  </section>

  <!-- Case placeholder -->
  <section class="py-12 bg-bg">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="section-title text-center">案例集</h2>
      <div class="card mt-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-2xl">🏫</span>
          <h3 class="text-xl font-bold">西城某小学 · 交通信号灯配时优化</h3>
        </div>
        <p class="text-text-light leading-relaxed mb-4">
          以真实路口的交通问题为驱动，融合数学、科学、社会学科，
          学生经历发现问题、分析问题、设计方案、检验迭代的完整过程。
        </p>
        <blockquote class="border-l-2 border-accent pl-4 py-2 bg-accent/5 rounded-r-lg">
          <p class="text-text italic text-sm">
            💬 "以前学生问我'这个考试考吗'，现在他们问的是'这个路口为什么这么堵'。"
          </p>
          <footer class="text-xs text-text-light mt-2">—— 该校教师</footer>
        </blockquote>
      </div>
      <p class="text-center text-sm text-text-light mt-6">
        更多案例正在整理中，欢迎联系我们分享你的学校案例
      </p>
    </div>
  </section>

  <CTA
    title="回到起点，重新梳理"
    primary={{ label: '👉 了解为什么要做', href: '/competency-hub/why' }}
    secondary={{ label: '📖 核心素养是什么', href: '/competency-hub/what' }}
  />
</BaseLayout>
